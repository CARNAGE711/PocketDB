{
  "name": "pocketdb",
  "productName": "PocketDB",
  "version": "1.2.0",
  "description": "PocketDB — a lightweight, offline-first NoSQL document database studio and local storage engine.",
  "main": "electron/main.cjs",
  "license": "MIT",
  "author": "PocketDB Team",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "cross-env NODE_ENV=development electron .",
    "dev": "concurrently -k \"npm:dev:vite\" \"npm:dev:electron\"",
    "build": "vite build",
    "start": "npm run build && electron .",
    "package": "npm run build && electron-builder",
    "mcp": "node electron/mcp-server.cjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "electron-updater": "^6.8.11",
    "lucide-react": "^0.454.0",
    "monaco-editor": "^0.52.0",
    "mongodb": "^7.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.0.2",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.10",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.pocketdb.studio",
    "productName": "PocketDB",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "electron/mcp-server.cjs",
        "to": "mcp/mcp-server.cjs"
      },
      {
        "from": "electron/db",
        "to": "mcp/db"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false,
      "forceCodeSigning": false,
      "icon": "build/icon.ico"
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PocketDB"
    },
    "afterPack": "scripts/afterPack.cjs",
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true
  }
}
